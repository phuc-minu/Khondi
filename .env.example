PORT=8000
ENVIRONMENT=local
# The api connects as khondi_app (read/write data only); its password is POSTGRES_APP_PASSWORD.
DATABASE_URL=postgresql://khondi_app:khondi_app_local@postgres:5432/khondi
REDIS_URL=redis://redis:6379/0
# Unauthenticated /v1/diagnostics routes that queue a test job (T0006). Local only; off by default.
DIAGNOSTICS_ENABLED=true
API_BASE_URL=http://api:8000
# Where the api and worker send traces and logs (T0007). Leave empty to export nothing.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# The migrate job connects as the schema owner (POSTGRES_USER / POSTGRES_PASSWORD).
MIGRATIONS_DATABASE_URL=postgresql://khondi:khondi@postgres:5432/khondi
# Local PostgreSQL container only; must match the users, passwords and database in the URLs above.
POSTGRES_USER=khondi
POSTGRES_PASSWORD=khondi
POSTGRES_DB=khondi
POSTGRES_APP_PASSWORD=khondi_app_local
# Host-side ports (local only). Change one if something on your computer already uses it.
# KHONDI_WEB_PORT=3000
# KHONDI_API_PORT=8000
# KHONDI_PG_PORT=5432
# KHONDI_REDIS_PORT=6379
# KHONDI_GRAFANA_PORT=3001
# KHONDI_OTLP_HTTP_PORT=4318
