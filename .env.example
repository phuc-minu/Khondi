PORT=8000
ENVIRONMENT=local
DATABASE_URL=postgresql://khondi:khondi@postgres:5432/khondi
REDIS_URL=redis://redis:6379/0
API_BASE_URL=http://api:8000
# Local PostgreSQL container only; must match the user, password and database in DATABASE_URL.
POSTGRES_USER=khondi
POSTGRES_PASSWORD=khondi
POSTGRES_DB=khondi
